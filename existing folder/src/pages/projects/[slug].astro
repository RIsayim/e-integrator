---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Scene from '../../components/Scene.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const index = projects.findIndex((item) => item.slug === project.slug);
const previous = projects[index - 1];
const next = projects[index + 1];
const gallery = project.gallery.slice(1);
---

<BaseLayout title={`${project.title} — Design & Co`}>
  <section class="project-showcase-hero">
    <Scene tone={project.scene} asset={project.image} loading="eager" label={`${project.title} hero visual`} />
    <div class="shell project-showcase-hero__content" data-reveal>
      <div class="project-showcase-hero__copy">
        <div class="project-showcase-hero__heading">
          <a class="back-link" href="/projects/" aria-label="Back to projects">←</a>
          <h1>{project.title}</h1>
        </div>
        <p class="location-chip"><span>⌖</span>{project.location}</p>
      </div>
    </div>
  </section>

  <section class="project-overview">
    <div class="shell">
      <div class="project-overview__intro" data-reveal>
        <p class="eyebrow">(project description)</p>
        <p class="detail-copy">{project.description}</p>
      </div>
      <div class="project-overview__body">
        <Scene tone={project.scene} asset={project.gallery[0]} label={`${project.title} interior showcase`} />
        <dl class="project-meta" data-reveal>
          <div><dt>Category</dt><dd>{project.category}</dd></div>
          <div><dt>Client</dt><dd>{project.client}</dd></div>
          <div><dt>Year</dt><dd>{project.year}</dd></div>
          <div><dt>Services</dt><dd>{project.services.map((service) => <span class="service-tag">{service}</span>)}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="project-gallery">
    <div class="shell project-gallery__grid">
      {gallery.map((asset, galleryIndex) => <Scene tone={galleryIndex % 2 ? project.scene : 'sand'} asset={asset} label={`${project.title} gallery visual ${galleryIndex + 3}`} />)}
    </div>
  </section>

  <nav class="shell project-pagination" aria-label="Project navigation">
    {previous ? <a href={`/projects/${previous.slug}/`}>← Previous</a> : <span />}
    {next ? <a href={`/projects/${next.slug}/`}>Next →</a> : <span />}
  </nav>

  <section class="project-cta" data-reveal>
    <div>
      <h2>let’s create something timeless</h2>
      <p>Have a project in mind? Let’s bring your vision to life.</p>
      <a class="pill-button pill-button--cream" href="/#contact">Start your project</a>
    </div>
  </section>
</BaseLayout>
