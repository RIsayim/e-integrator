---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Scene from '../components/Scene.astro';
import { projects } from '../data/projects';
const services = [
  ['Residential Interior Design', 'We create spaces that reflect your lifestyle, blending comfort, elegance, and timeless design principles.', 'sand'],
  ['Commercial Interior Design', 'We design purposeful environments that enhance brand identity and improve the way people work and connect.', 'charcoal'],
  ['Renovation & Project Management', 'We oversee every stage with precision, ensuring each detail aligns seamlessly with your vision and goals.', 'forest']
];
const principles = [['Simplicity', 'We value clean lines and thoughtful restraint, allowing each element to breathe and serve a purpose.', 'clay'], ['Harmony', 'Every space should feel cohesive — a seamless blend of materials, colors, and light designed to inspire calm and comfort.', 'ocean'], ['Longevity', 'We design with intention, ensuring each decision stands the test of time in both style and quality.', 'rose']];
---
<BaseLayout>
  <section class="hero wrap">
    <div class="hero__content"><p class="eyebrow">Based in New York, USA</p><h1>Timeless Interiors.<br />Crafted for You.</h1><p class="lede">We create refined spaces that blend comfort, beauty, and lasting design — tailored to the way you live.</p><a class="button" href="/projects/">See projects <span>↗</span></a></div>
    <Scene tone="sand" label="Warm, modern living room visual" />
  </section>

  <section class="section wrap" id="work"><SectionHeading eyebrow="(works)" title="Featured works" /><div class="projects-grid">{projects.slice(0, 4).map((project) => <ProjectCard project={project} />)}</div><a class="text-link" href="/projects/">View all <span>↗</span></a></section>

  <section class="section about wrap" id="about"><div><SectionHeading eyebrow="(about)" title="Designing Interiors with Purpose and Precision" /><p class="lede">We approach every space as a balance of function, form, and feeling. Through thoughtful materials, light, and texture, we create interiors that reflect individuality while standing the test of time.</p><a class="text-link" href="#contact">Get in touch <span>↗</span></a></div><Scene tone="clay" label="Textural interior visual" /><div class="stats"><div><strong>80+</strong><span>Projects completed</span></div><div><strong>12+</strong><span>Years of experience</span></div><div><strong>16</strong><span>Awards &amp; recognition</span></div></div></section>

  <section class="section wrap" id="services"><SectionHeading eyebrow="(services)" title="Design Services — Tailored to You" /><div class="services-list">{services.map(([name, copy, tone], index) => <article class="service"><span class="service__number">0{index + 1}</span><div><h3>{name}</h3><p>{copy}</p><a class="text-link" href="#contact">Book this service <span>↗</span></a></div><Scene tone={tone} label={`${name} visual`} /></article>)}</div></section>

  <section class="testimonial wrap"><div><p class="eyebrow">(testimonials)</p><h2>What Our Clients Say</h2><blockquote>“From the first meeting, they understood our vision completely. The final design feels effortless — every room flows beautifully and captures exactly what we hoped for.”</blockquote><p class="client"><strong>Emma Collins</strong><span>House Owner</span></p></div><Scene tone="rose" label="Elegant bedroom interior visual" /></section>

  <section class="section wrap"><SectionHeading eyebrow="(philosophy)" title="Our Design Philosophy" /><div class="principles">{principles.map(([name, copy, tone]) => <article><Scene tone={tone} label={`${name} design principle visual`} /><h3>{name}</h3><p>{copy}</p></article>)}</div></section>

  <section class="section wrap"><SectionHeading eyebrow="(team)" title="The Minds Behind the Design" /><div class="team">{[['Ethan Cole','Lead Interior Designer','sand'],['Lucas Grant','Creative Director','charcoal'],['Noah Reed','Senior Architect','forest'],['Adrian Blake','Project Manager','clay']].map(([name, role, tone]) => <article><Scene tone={tone} label={`${name} profile visual`} /><h3>{name}</h3><p class="eyebrow">{role}</p><p>Bringing a considered eye and deep expertise to interiors designed for lasting connection.</p></article>)}</div></section>

  <section class="section faq wrap"><SectionHeading eyebrow="(faq)" title="Frequently Asked Questions" />{[['What services do you offer?','We provide full interior design services including space planning, styling, and project management.'],['Do you handle both residential and commercial projects?','Yes, we work on a variety of spaces — from private homes to modern offices.'],['How long does a typical project take?','Timelines vary by scope, but most projects are completed within 8–12 weeks.'],['Can you work with my existing furniture?','Absolutely. We love blending new design elements with your existing pieces.'],['How can I start a project with you?','Simply reach out through our contact form, and we’ll schedule an initial consultation.']].map(([question, answer]) => <details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</section>

  <section class="contact section wrap" id="contact"><div><SectionHeading eyebrow="(contact)" title="Get in touch" /><dl><dt>Address</dt><dd>248 Mercer Street, Suite 4B<br />New York, NY 10012</dd><dt>Email</dt><dd><a href="mailto:hello@designandco.example">hello@designandco.example</a></dd><dt>Phone</dt><dd>+1 212 555 0128</dd><dt>Hours</dt><dd>Monday to Friday, 8:30am – 5:00pm</dd></dl><Scene tone="ocean" label="Contact section interior visual" /></div><form action="/" method="post"><label>Name<input name="name" placeholder="Jane Smith" required /></label><label>Email<input name="email" type="email" placeholder="jane@example.com" required /></label><label>Message<textarea name="message" rows="6" placeholder="Tell us about your project"></textarea></label><button class="button" type="submit">Submit <span>↗</span></button></form></section>
</BaseLayout>
