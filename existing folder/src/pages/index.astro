---
import BaseLayout from '../layouts/BaseLayout.astro';
import Scene from '../components/Scene.astro';
import { projects } from '../data/projects';
import { coreServices } from '../data/services';
import { assetUrl } from '../utils/asset-url';

const base = import.meta.env.BASE_URL;
const showcaseProjects = [...projects, ...projects, ...projects];
const showcaseInitialIndex = projects.length;
const aboutSliderImages = [
  { asset: 'home_automation_001.png', label: 'Smart home control interface' },
  { asset: 'lighting_003.jpeg', label: 'Architectural lighting installation' },
  { asset: 'home_cinema_007.jpg', label: 'Private home cinema' },
  { asset: 'audio_005.jpg', label: 'Multi-room audio experience' },
  { asset: 'security_surveillance_010.jpg', label: 'Integrated home security' },
  { asset: 'network_wifi_006.jpg', label: 'Reliable home connectivity' }
];
const aboutSliderSecondRow = [...aboutSliderImages.slice(3), ...aboutSliderImages.slice(0, 3)];

const approach = [
  { title: 'Simple', copy: 'Technology should make the home easier to use, not more complicated.', image: 'home_automation_001.png' },
  { title: 'Integrated', copy: 'Every system should work together as one connected experience.', image: 'network_wifi_005.jpg' },
  { title: 'Discreet', copy: 'The best technology supports the architecture without competing with it.', image: 'lighting_004.jpeg' }
];

const team = [
  { role: 'Technology Director', image: 'audio_001.jpg', bio: 'Guiding every project from the first conversation through a refined, dependable technology experience.' },
  { role: 'Systems Designer', image: 'lighting_003.jpeg', bio: 'Designing intuitive control, lighting and entertainment systems around each home and its architecture.' },
  { role: 'Project Manager', image: 'outdoor_living_003.jpg', bio: 'Coordinating details, trades and timelines so installation feels considered from start to finish.' },
  { role: 'Integration Specialist', image: 'network_wifi_006.jpg', bio: 'Programming and commissioning every connected system for simple, reliable everyday use.' }
];

const testimonials = [
  { name: 'Private Homeowner', role: 'Residential Project', background: 'outdoor_living_001.jpg', quote: '“Orion transformed the way we experience our home. Everything from lighting and music to security now works together effortlessly.”' },
  { name: 'Private Homeowner', role: 'Whole Home Upgrade', background: 'lighting_002.jpeg', quote: '“The technology feels almost invisible. The house simply responds the way we want it to.”' },
  { name: 'Private Homeowner', role: 'New Construction', background: 'home_cinema_006.jpg', quote: '“Every detail was considered. We have powerful technology, yet the home still feels calm and beautifully resolved.”' }
];

const faqs = [
  ['What is smart home integration?', 'Smart home integration connects your home technology into one simple and coordinated control experience.'],
  ['Can you integrate technology into an existing home?', 'Yes. Solutions can be designed for new construction and existing properties depending on infrastructure and project requirements.'],
  ['Can different brands work together?', 'Yes. We design systems that allow compatible technology from different manufacturers to work together seamlessly.'],
  ['Do you provide ongoing support?', 'Yes. Orion can provide ongoing support, system updates and maintenance after installation.'],
  ['Can I control my home remotely?', 'Yes. Supported systems can provide secure control of lighting, climate, security and entertainment from compatible mobile devices.']
];
---

<BaseLayout title="Orion | Smart Home Integration Services">
  <section class="hero hero--home" id="home">
    <video class="home-hero__video" autoplay muted loop playsinline preload="auto" poster={assetUrl('home_automation_001.png')} aria-label="A walkthrough of a considered interior space">
      <source src={`${base}home-hero.mp4`} type="video/mp4" />
    </video>
    <div class="home-hero__veil"></div>
    <div class="shell hero__content home-hero__content" data-reveal>
      <div class="hero__copy home-hero__copy">
        <h1>Intelligent Home<br />Simplified</h1>
        <p>We design and install integrated home technology systems tailored to your space and your lifestyle.</p>
        <div class="home-hero__actions">
          <a class="home-hero__secondary" href={`${base}contact/`}>Call or Text Us</a>
          <a class="pill-button home-hero__primary" href={`${base}consultation/`} data-static-cta>Schedule a Consultation <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
    <div class="home-hero__scroll" aria-hidden="true"><span></span>Scroll to explore</div>
    <div class="home-hero__surface">
      <div class="home-hero__grid" data-reveal>
        <div class="home-hero__copy">
          <h1>Technology that<br />feels effortless.</h1>
          <p>We bring lighting, entertainment, climate, security and connectivity together into one beautiful, intuitive home experience.</p>
          <a class="pill-button hero__cta" href="#projects" data-static-cta>Explore Our Work <span aria-hidden="true">↗</span></a>
          <div class="home-hero__stats" aria-label="Orion statistics">
            <div><strong>60+</strong><span>Projects<br />completed</span></div>
            <div><strong>10+</strong><span>Years of<br />experience</span></div>
            <div><strong>30+</strong><span>Technology<br />partners</span></div>
          </div>
        </div>
        <div class="home-hero__visuals">
          <Scene asset="lighting_001.jpg" loading="eager" label="Architectural lighting in a luxury home" />
          <Scene asset="home_automation_001.png" loading="eager" label="Orion smart home control" />
        </div>
      </div>
    </div>
  </section>

  <section class="who-we-are-section" id="who-we-are">
    <div class="who-we-are__surface">
      <div class="who-we-are__grid">
        <Scene asset="outdoor_living_002.jpg" label="Orion connected luxury home" />
        <div class="who-we-are__copy">
          <p class="eyebrow">(who we are)</p>
          <h2>Technology, Designed<br />for the Way You Live.</h2>
          <p>At Orion, we create intelligent home environments where lighting, entertainment, climate, security and connectivity feel effortless from the first day.</p>
          <div class="who-we-are__list">
            <article class="who-we-are__item is-open"><button class="who-we-are__toggle" type="button" aria-expanded="true"><span>Designed Around You</span><i aria-hidden="true">+</i></button><div class="who-we-are__panel"><p>Every system begins with the people, spaces and routines it is designed to support.</p></div></article>
            <article class="who-we-are__item"><button class="who-we-are__toggle" type="button" aria-expanded="false"><span>Integrated With Care</span><i aria-hidden="true">+</i></button><div class="who-we-are__panel"><p>Our work brings trusted technology together with a quiet, architectural approach to installation.</p></div></article>
          </div>
          <a class="pill-button" href={`${base}about/`}>Learn More <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="project-showcase" id="projects" data-project-showcase data-project-count={projects.length} data-project-initial-index={showcaseInitialIndex}>
    <div class="project-showcase__surface">
      <div class="project-showcase__heading">
        <p class="eyebrow">(featured projects)</p>
        <h2>Selected Integrations</h2>
        <p>Explore a selection of intelligent home environments, designed to feel as natural as the spaces they support.</p>
      </div>
      <div class="project-showcase__slider" data-project-slider>
        <div class="project-showcase__viewport" data-project-viewport tabindex="0" aria-label="Featured Orion projects">
          <div class="project-showcase__track">
            {showcaseProjects.map((project, index) => (
              <a class:list={['project-showcase__card', { 'is-current': index === showcaseInitialIndex }]} href={`${base}projects/${project.slug}/`} data-project-card data-project-real-index={index % projects.length} aria-label={`View ${project.title}`}>
                <Scene asset={project.thumbnailImage} label={project.title} loading={index === showcaseInitialIndex ? 'eager' : 'lazy'} />
                <span class="project-showcase__shade" aria-hidden="true"></span>
                <span class="project-showcase__card-copy"><span>Completed · {project.year}</span><strong>{project.title}</strong><em>{project.category}</em></span>
              </a>
            ))}
          </div>
        </div>
        <div class="project-showcase__footer">
          <div class="project-showcase__navigation">
            <button type="button" data-project-prev aria-label="Previous project">&#8592;</button>
            <span data-project-current aria-live="polite">01 / {String(projects.length).padStart(2, '0')}</span>
            <button type="button" data-project-next aria-label="Next project">&#8594;</button>
          </div>
        </div>
      </div>
    </div>
  </section>


  <section class="home-section services-section" id="services">
    <div class="shell">
      <div class="section-intro section-intro--center" data-reveal><p class="eyebrow">(our services)</p><h2>Technology Tailored<br />to Your Home</h2></div>
      <div class="services-list">
        {coreServices.map((service) => <article class="service-row" id={`service-${service.slug}`}><div class="service-row__copy"><p class="eyebrow">({service.number})</p><h3>{service.title}</h3><p>{service.shortDescription}</p><a class="pill-button" href={`${base}services/${service.slug}/`}>Explore Service</a></div><Scene asset={service.heroImage} label={service.title} /></article>)}
      </div>
    </div>
  </section>

    <section class="about-sliders-section" id="about">
    <!-- <div class="shell about-sliders-section__intro" data-reveal>
      <p class="eyebrow">(about orion)</p>
      <div>
        <h2>Technology Made<br />Effortlessly Simple</h2>
        <p>Orion brings lighting, entertainment, climate, security, networking and smart-home control together into one beautifully integrated experience.</p>
      </div>
    </div> -->
    <div class="about-sliders" aria-label="Orion technology systems" role="region">
      <div class="about-sliders__container">
        <div class="about-slider" data-about-slider data-duration="77" data-reversed="false" data-width="112">
          <div class="about-slider__drag">
          <div class="about-sliders__group">
            {aboutSliderImages.map((image) => <div class="about-sliders__card"><Scene asset={image.asset} label={image.label} /></div>)}
          </div>
          <div class="about-sliders__group" aria-hidden="true">
            {aboutSliderImages.map((image) => <div class="about-sliders__card"><Scene asset={image.asset} label="" /></div>)}
          </div>
        </div>
      </div>
      </div>
      <div class="about-sliders__container">
        <div class="about-slider" data-about-slider data-duration="77" data-reversed="true" data-width="112">
          <div class="about-slider__drag">
          <div class="about-sliders__group">
            {aboutSliderSecondRow.map((image) => <div class="about-sliders__card"><Scene asset={image.asset} label={image.label} /></div>)}
          </div>
          <div class="about-sliders__group" aria-hidden="true">
            {aboutSliderSecondRow.map((image) => <div class="about-sliders__card"><Scene asset={image.asset} label="" /></div>)}
          </div>
        </div>
      </div>
    </div>
  </section>



  <!-- <section class="home-section faq-section" id="faq"><div class="shell shell--narrow"><div class="section-intro section-intro--center" data-reveal><p class="eyebrow">(faq)</p><h2>Frequently Asked Questions</h2></div><div class="faq-list">{faqs.map(([question, answer]) => <details data-reveal><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div></div></section> -->

  <section class="contact-cta" id="contact" data-contact-cta>
    <div class="contact-cta__media"><Scene asset="audio_001.jpg" loading="lazy" label="Integrated home entertainment and lighting" /></div>
    <div class="contact-cta__shade" aria-hidden="true"></div>
    <div class="shell contact-cta__content">
      <h2>Let’s talk about<br />your home—we’re<br />ready when you are.</h2>
      <p class="contact-cta__intro">Every exceptional system starts with a conversation. Tell us how you live, and we’ll create technology that feels considered from the very first day.</p>
      <aside class="contact-cta__card" aria-label="Start a project with Orion">
        <div class="contact-cta__card-head">
          <div class="contact-cta__avatar"><Scene asset="home_automation_001.png" label="Orion smart home specialist" /></div>
          <div><strong>Orion</strong><span>Smart home specialists</span></div>
          <i aria-hidden="true">✦</i>
        </div>
        <div class="contact-cta__card-body">
          <p>With clarity, care, and technology designed around you.</p>
          <a class="contact-cta__button" href={`${base}contact/`}>Get a Quote <span aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </div>
  </section>

  <script>
    const quote = document.querySelector<HTMLElement>('[data-testimonial-quote]'); const name = document.querySelector<HTMLElement>('[data-testimonial-name]'); const role = document.querySelector<HTMLElement>('[data-testimonial-role]'); const image = document.querySelector<HTMLImageElement>('.testimonial-card > .scene .scene__image'); const buttons = document.querySelectorAll<HTMLButtonElement>('[data-testimonial-avatar]');
    buttons.forEach((button) => button.addEventListener('click', () => { buttons.forEach((item) => { const active = item === button; item.classList.toggle('is-selected', active); item.setAttribute('aria-pressed', String(active)); }); if (quote) quote.textContent = button.dataset.quote ?? ''; if (name) name.textContent = button.dataset.name ?? ''; if (role) role.textContent = button.dataset.role ?? ''; if (image && button.dataset.background) image.src = button.dataset.background; }));
    const stats = document.querySelectorAll<HTMLElement>('[data-stat-target]'); const observer = new IntersectionObserver((entries) => { if (!entries.some((entry) => entry.isIntersecting)) return; stats.forEach((stat) => { const target = Number(stat.dataset.statTarget); stat.textContent = `${target}+`; }); observer.disconnect(); }, { threshold: .35 }); if (stats[0]) observer.observe(stats[0]);
    document.querySelectorAll<HTMLButtonElement>('[data-team-toggle]').forEach((button) => button.addEventListener('click', () => { const open = button.getAttribute('aria-expanded') === 'true'; button.setAttribute('aria-expanded', String(!open)); button.closest<HTMLElement>('.team-card')?.classList.toggle('is-open', !open); }));
    document.querySelectorAll<HTMLButtonElement>('.who-we-are__toggle').forEach((button) => button.addEventListener('click', () => { const item = button.closest<HTMLElement>('.who-we-are__item'); const open = item?.classList.contains('is-open') ?? false; document.querySelectorAll<HTMLElement>('.who-we-are__item').forEach((entry) => { entry.classList.remove('is-open'); entry.querySelector<HTMLButtonElement>('.who-we-are__toggle')?.setAttribute('aria-expanded', 'false'); }); if (!open) { item?.classList.add('is-open'); button.setAttribute('aria-expanded', 'true'); } }));
    const projectShowcase = document.querySelector<HTMLElement>('[data-project-showcase]');
    const projectViewport = projectShowcase?.querySelector<HTMLElement>('[data-project-viewport]');
    const projectTrack = projectShowcase?.querySelector<HTMLElement>('.project-showcase__track');
    const projectCards = Array.from(projectShowcase?.querySelectorAll<HTMLElement>('[data-project-card]') ?? []);
    const projectPrevious = projectShowcase?.querySelector<HTMLButtonElement>('[data-project-prev]');
    const projectNext = projectShowcase?.querySelector<HTMLButtonElement>('[data-project-next]');
    const projectCurrent = projectShowcase?.querySelector<HTMLElement>('[data-project-current]');
    const projectRealCount = Number(projectShowcase?.dataset.projectCount ?? 0);
    let projectActiveIndex = Number(projectShowcase?.dataset.projectInitialIndex ?? Math.floor(projectCards.length / 2));
    let projectDragStartX = 0;
    let projectDragStartOffset = 0;
    let projectIsDragging = false;
    let projectOffset = 0;
    let projectSuppressClick = false;

    const projectOffsetFor = (index: number) => {
      if (!projectViewport || !projectCards[index]) return 0;
      const card = projectCards[index];
      if (window.matchMedia('(max-width: 809px)').matches) return -card.offsetLeft;
      return projectViewport.clientWidth / 2 - (card.offsetLeft + card.offsetWidth / 2);
    };

    const setProjectTrack = (index: number, animate = true) => {
      if (!projectTrack || !projectCards.length) return;
      projectActiveIndex = index;
      projectOffset = projectOffsetFor(index);
      projectTrack.classList.toggle('is-animating', animate);
      projectTrack.style.transform = `translate3d(${projectOffset}px, 0, 0)`;
      projectCards.forEach((card, cardIndex) => card.classList.toggle('is-current', cardIndex === projectActiveIndex));
      const realIndex = Number(projectCards[projectActiveIndex].dataset.projectRealIndex ?? 0);
      if (projectCurrent) projectCurrent.textContent = `${String(realIndex + 1).padStart(2, '0')} / ${String(projectRealCount).padStart(2, '0')}`;
    };

    const moveProject = (direction: number) => {
      if (!projectRealCount || !projectCards.length) return;
      setProjectTrack(projectActiveIndex + direction);
    };

    if (projectViewport && projectTrack && projectCards.length && projectRealCount) {
      requestAnimationFrame(() => setProjectTrack(projectActiveIndex, false));
      projectTrack.addEventListener('transitionend', (event) => {
        if (event.propertyName !== 'transform') return;
        if (projectActiveIndex >= projectRealCount * 2) setProjectTrack(projectActiveIndex - projectRealCount, false);
        if (projectActiveIndex < projectRealCount) setProjectTrack(projectActiveIndex + projectRealCount, false);
      });
      window.addEventListener('resize', () => setProjectTrack(projectActiveIndex, false));
      projectViewport.addEventListener('pointerdown', (event) => { projectIsDragging = true; projectSuppressClick = false; projectDragStartX = event.clientX; projectDragStartOffset = projectOffset; projectViewport.setPointerCapture(event.pointerId); projectViewport.classList.add('is-dragging'); projectTrack.classList.remove('is-animating'); });
      projectViewport.addEventListener('pointermove', (event) => { if (!projectIsDragging) return; const distance = event.clientX - projectDragStartX; if (Math.abs(distance) > 6) projectSuppressClick = true; projectTrack.style.transform = `translate3d(${projectDragStartOffset + distance}px, 0, 0)`; });
      const stopProjectDrag = (event: PointerEvent) => { if (!projectIsDragging) return; projectIsDragging = false; projectViewport.classList.remove('is-dragging'); const distance = event.clientX - projectDragStartX; const threshold = projectCards[0].offsetWidth * .14; if (Math.abs(distance) > threshold) moveProject(distance < 0 ? 1 : -1); else setProjectTrack(projectActiveIndex); };
      projectViewport.addEventListener('pointerup', stopProjectDrag);
      projectViewport.addEventListener('pointercancel', stopProjectDrag);
      projectViewport.addEventListener('click', (event) => { if (projectSuppressClick) { event.preventDefault(); event.stopPropagation(); projectSuppressClick = false; } }, true);
    }
    projectPrevious?.addEventListener('click', () => moveProject(-1));
    projectNext?.addEventListener('click', () => moveProject(1));

  </script>
</BaseLayout>
