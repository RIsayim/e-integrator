---
import Scene from './Scene.astro';
import type { Project } from '../data/projects';
const { project, featured = false } = Astro.props as { project: Project; featured?: boolean };
---
<a class:list={['project-card', { 'project-card--featured': featured }]} href={`/projects/${project.slug}/`}>
  <Scene tone={project.scene} asset={project.image} label={`${project.title} project visual`} />
  <h3 class="project-card__title"><span>{project.title}</span><span aria-hidden="true">{project.title}</span></h3>
</a>
