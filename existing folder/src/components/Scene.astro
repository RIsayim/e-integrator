---
const { tone = 'sand', label = 'Interior design visual placeholder' } = Astro.props;
---
<div class={`scene scene--${tone}`} role="img" aria-label={label}>
  <div class="scene__sun"></div><div class="scene__window"></div><div class="scene__wall"></div><div class="scene__sofa"></div><div class="scene__table"></div><div class="scene__plant"></div>
</div>
