---
import '../styles/global.css';
import '../styles/reference-overrides.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title = 'Design & Co — Interior Design' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A considered interior design studio portfolio." />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <script>
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reveal = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            reveal.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      targets.forEach((target) => reveal.observe(target));
    </script>
  </body>
</html>
